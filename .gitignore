# ============================================================
# Bubble Shooter 2 — Unity 项目 .gitignore
# ============================================================

# ---------- Unity 自动生成的目录（务必忽略）----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ll]ocal[Bb]uild/
*.unitypackage

# ---------- Unity 生成的 IDE / 工程文件 ----------
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# ---------- Unity 崩溃 / 遥测产物 ----------
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/[Aa]ssetStoreTools*

# ---------- 构建产物 ----------
*.apk
*.aab
*.ipa
*.app
*.x86
*.x64
*.exe

# ---------- 操作系统杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 临时 / 编辑器文件 ----------
*.log
*.tmp
*.bak
*.orig
*.swp
*~

# ---------- 依赖与缓存 ----------
node_modules/
.cache/
.npm/

# ---------- 参考工程（Web 原项目）里的生成产物 ----------
# 保留 docs/ 与 game/ 源码作为参考；忽略体积大且可再生成的输出
/Assets/02-工程文件及说明/output/
/Assets/02-工程文件及说明/archive/
